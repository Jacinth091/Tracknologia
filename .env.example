# Supabase public project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application origin URL (used for password reset emails and absolute redirect callbacks)
# Example: http://localhost:3000 (development) or https://app.tracknologia.com (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Never add Supabase service-role/secret values with NEXT_PUBLIC_ prefixes.
